<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pantaloons - Women Store (Mock)</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <h1>Pantaloons</h1>
    <nav>
      <a href="#">Women</a>
      <a href="#">Men</a>
      <a href="#">Kids</a>
      <a href="#">Sale</a>
    </nav>
  </header>

  <section class="hero">
    <h2>Fresh Styles for Women</h2>
    <p>Explore the latest trends in casuals, ethnic wear, and more</p>
  </section>

  <section class="product-grid">
    <div class="product-card">
      <img src="https://via.placeholder.com/200x250" alt="Product 1">
      <h3>Printed Kurta</h3>
      <p>₹999</p>
    </div>
    <div class="product-card">
      <img src="https://via.placeholder.com/200x250" alt="Product 2">
      <h3>Denim Jeans</h3>
      <p>₹1,299</p>
    </div>
    <div class="product-card">
      <img src="https://via.placeholder.com/200x250" alt="Product 3">
      <h3>Summer Dress</h3>
      <p>₹1,599</p>
    </div>
    <div class="product-card">
      <img src="https://via.placeholder.com/200x250" alt="Product 4">
      <h3>Floral Top</h3>
      <p>₹699</p>
    </div>
  </section>
</body>
</html>


* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: sans-serif;
}

body {
  background-color: #f9f9f9;
  color: #333;
}

header {
  background-color: #000;
  color: #fff;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

header h1 {
  font-size: 1.5rem;
}

header nav a {
  color: #fff;
  margin-left: 1.5rem;
  text-decoration: none;
  font-weight: 500;
}

.hero {
  background-color: #fff2f2;
  text-align: center;
  padding: 2rem 1rem;
}

.hero h2 {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  padding: 2rem;
}

.product-card {
  background-color: white;
  padding: 1rem;
  border-radius: 10px;
  text-align: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.product-card img {
  width: 100%;
  border-radius: 8px;
}

.product-card h3 {
  margin: 0.5rem 0;
}

.product-card p {
  color: #e91e63;
  font-weight: bold;
}


