<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pantaloons - Men Store (Mock)</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <h1>Pantaloons</h1>
    <nav>
      <a href="#">Men</a>
      <a href="#">Women</a>
      <a href="#">Kids</a>
      <a href="#">Sale</a>
    </nav>
  </header>

  <section class="hero hero-men">
    <h2>Style Up with the Latest in Menswear</h2>
    <p>Casuals, Formals, Ethnic & More</p>
  </section>

  <section class="product-grid">
    <div class="product-card">
      <img src="https://via.placeholder.com/200x250?text=Shirt" alt="Product 1">
      <h3>Checked Shirt</h3>
      <p>₹1,099</p>
    </div>
    <div class="product-card">
      <img src="https://via.placeholder.com/200x250?text=Trousers" alt="Product 2">
      <h3>Formal Trousers</h3>
      <p>₹1,299</p>
    </div>
    <div class="product-card">
      <img src="https://via.placeholder.com/200x250?text=Kurta" alt="Product 3">
      <h3>Solid Kurta</h3>
      <p>₹999</p>
    </div>
    <div class="product-card">
      <img src="https://via.placeholder.com/200x250?text=Denim" alt="Product 4">
      <h3>Distressed Denim</h3>
      <p>₹1,599</p>
    </div>
  </section>
</body>
</html>

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: sans-serif;
}

body {
  background-color: #f8f8f8;
  color: #333;
}

header {
  background-color: #111;
  color: white;
  padding: 1rem 2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

header h1 {
  font-size: 1.5rem;
}

header nav a {
  color: white;
  margin-left: 1.5rem;
  text-decoration: none;
  font-weight: 500;
}

.hero-men {
  background-color: #eef6ff;
  text-align: center;
  padding: 2rem 1rem;
}

.hero-men h2 {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  padding: 2rem;
}

.product-card {
  background-color: white;
  padding: 1rem;
  border-radius: 10px;
  text-align: center;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

.product-card img {
  width: 100%;
  border-radius: 8px;
}

.product-card h3 {
  margin: 0.5rem 0;
}

.product-card p {
  color: #0073e6;
  font-weight: bold;
}
